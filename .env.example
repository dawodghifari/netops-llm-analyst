# Copy this file to `.env` and fill in ONE provider's key. The app auto-detects which.
# .env is git-ignored — never commit your real keys.

# --- Option A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Option B: OpenAI (GPT) ---
OPENAI_API_KEY=

# Optional overrides:
# LLM_PROVIDER=anthropic        # force a provider if both keys are set
# LLM_MODEL=claude-3-5-sonnet-latest
# NETOPS_DB=data/netops.db      # path to the SQLite database
